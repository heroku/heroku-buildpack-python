#!/usr/bin/env bash

# This file is run by the inline buildpack, and tests that the environment is
# configured as expected for buildpacks that run after the Python buildpack.

set -euo pipefail

BUILD_DIR="${1}"
CACHE_DIR="${2}"

cd "${BUILD_DIR}"

echo "Build-time env vars:"
bin/print-env-vars.sh
echo

echo "Python sys.path:"
python -c 'import pprint, sys; pprint.pp(sys.path)'
echo

echo "Package manager version and installed packages:"
uv --version
uv pip list
echo

python -c 'import typing_extensions; print(f"typing_extensions imported from: {typing_extensions.__file__}")'
echo

echo "Contents of build-data/python.json:"
jq --sort-keys '.' "${CACHE_DIR}/build-data/python.json"
